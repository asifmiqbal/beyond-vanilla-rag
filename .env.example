# ==============================================================================
# Logic42 AI - Telco AI Intent Routing & RAG Benchmark Environment Template
# ==============================================================================
# Copy this file to .env and insert your personal API keys for reproduction.
# DO NOT commit your live .env file to public version control.

# TypeSafe AI Jev Configuration (Used for Stream B / Jev Decision Model)
# Register at https://console.typesafe.ai to obtain your API key:
TYPESAFE_API_KEY=your_typesafe_api_key_here
TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone

# Local LLM Serving via Ollama (Local SLM Streams: Qwen 1.7B and Qwen 2.5 7B)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL_1_7B=qwen3:1.7b
OLLAMA_MODEL_7B=qwen2.5:7b

# Google AI Studio Configuration (Frontier Cloud LLM Baseline: Gemini 3.8 Flash)
# Generate your API key at https://aistudio.google.com/app/apikey:
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Knowledge Base Storage
LANCEDB_PATH=knowledge_base/lancedb
